const Payment = require("../models/Payment");
const Business = require("../models/Business");
const Transaction = require("../models/Transaction");

const { getProvider } =
    require("../providers/provider.registry");

const {
    requireCapability
} = require("../providers/provider.interface");

const {
    isProviderActive
} = require("./providerConfig.service");

const {
    triggerWebhook
} = require("./webhook.service");

const {
    createPaymentFingerprint
} = require("../utils/paymentFingerprint");

const {
    IdempotencyConflictError
} = require("../errors/idempotency.error");

const createPayment = async ({
    businessId,
    amount,
    currency,
    country,
    provider,
    paymentMethod,
    customerName,
    customerEmail,
    customerPhone,
    description,
    metadata,
    reference,
    idempotencyKey
}) => {
    if (!businessId) {
        throw new Error("Business ID is required.");
    }

    if (!amount || amount < 1) {
        throw new Error("A valid payment amount is required.");
    }

    if (!provider) {
        throw new Error("Payment provider is required.");
    }

    if (
        !idempotencyKey ||
        typeof idempotencyKey !== "string" ||
        !idempotencyKey.trim()
    ) {
        throw new Error("Idempotency key is required.");
    }

    const normalizedIdempotencyKey =
        idempotencyKey.trim();

    const requestFingerprint =
        createPaymentFingerprint({
            amount,
            currency,
            country,
            provider,
            paymentMethod,
            customerName,
            customerEmail,
            customerPhone,
            description,
            metadata
        });

    const business = await Business.findOne({
        _id: businessId,
        suspended: false
    });

    if (!business) {
        throw new Error(
            "Active business profile not found."
        );
    }

    const normalizedProvider =
        provider.toLowerCase().trim();

    const paymentProvider =
        getProvider(normalizedProvider);

    /*
     * Provider lifecycle guard:
     *
     * configured → validated → active
     *
     * No payment is allowed before all three
     * conditions are satisfied.
     */
    const active =
        await isProviderActive(
            normalizedProvider
        );

    if (!active) {
        throw new Error(
            `Payment provider "${normalizedProvider}" is not active or has not been validated.`
        );
    }

    /*
     * Every payment must be supported by the
     * provider's declared payment capability.
     */
    requireCapability(
        paymentProvider,
        "payments"
    );

    const normalizedCurrency = (
        currency ||
        business.currency ||
        "KES"
    ).toUpperCase();

    /*
     * Idempotency is enforced at the service layer.
     * Controllers must not duplicate this business logic.
     */
    const existingPayment =
        await Payment.findOne({
            business: business._id,
            idempotencyKey:
                normalizedIdempotencyKey
        });

    if (existingPayment) {
        if (
            existingPayment.requestFingerprint &&
            existingPayment.requestFingerprint !==
                requestFingerprint
        ) {
            throw new IdempotencyConflictError();
        }

        const existingTransaction =
            existingPayment.transaction
                ? await Transaction.findById(
                    existingPayment.transaction
                )
                : null;

        return {
            payment: existingPayment,
            transaction:
                existingTransaction,
            providerResult: null,
            idempotentReplay: true
        };
    }

    const transaction =
        await Transaction.create({
            business: business._id,
            type: "payment",
            reference,
            provider: normalizedProvider,
            amount,
            currency: normalizedCurrency,
            country: country || null,
            paymentMethod:
                paymentMethod || null,
            status: "pending",
            metadata: metadata || {}
        });

    let payment;

    try {
        payment =
            await Payment.create({
                business: business._id,
                transaction:
                    transaction._id,
                reference,
                idempotencyKey:
                    normalizedIdempotencyKey,
                requestFingerprint,
                amount,
                currency:
                    normalizedCurrency,
                country:
                    country || null,
                paymentMethod:
                    paymentMethod || null,
                provider:
                    normalizedProvider,
                customerName:
                    customerName || null,
                customerEmail:
                    customerEmail || null,
                customerPhone:
                    customerPhone || null,
                description:
                    description || null,
                metadata:
                    metadata || {},
                status: "pending"
            });
    } catch (error) {
        if (error?.code === 11000) {
            const existingPayment =
                await Payment.findOne({
                    business: business._id,
                    idempotencyKey:
                        normalizedIdempotencyKey
                });

            if (existingPayment) {
                if (
                    existingPayment.requestFingerprint &&
                    existingPayment.requestFingerprint !==
                        requestFingerprint
                ) {
                    await Transaction.deleteOne({
                        _id: transaction._id
                    });

                    throw new IdempotencyConflictError();
                }

                await Transaction.deleteOne({
                    _id: transaction._id
                });

                return {
                    payment: existingPayment,
                    transaction:
                        existingPayment.transaction
                            ? await Transaction.findById(
                                existingPayment.transaction
                            )
                            : null,
                    providerResult: null,
                    idempotentReplay: true
                };
            }
        }

        await Transaction.deleteOne({
            _id: transaction._id
        });

        throw error;
    }

    let providerResult;

    try {
        providerResult =
            await paymentProvider.initiatePayment({
                amount,
                currency:
                    normalizedCurrency,
                country:
                    country || null,
                paymentMethod:
                    paymentMethod || null,
                reference,
                customerName,
                customerEmail,
                customerPhone,
                description,
                metadata
            });
    } catch (error) {
        providerResult = {
            success: false,
            provider:
                normalizedProvider,
            status: "failed",
            message:
                error.message,
            paymentReference:
                reference
        };
    }

    if (!providerResult?.success) {
        payment.status =
            providerResult?.status ===
            "cancelled"
                ? "cancelled"
                : "failed";

        transaction.status =
            payment.status;

        payment.metadata = {
            ...(payment.metadata || {}),
            providerStatus:
                providerResult?.status ||
                "failed",
            providerMessage:
                providerResult?.message ||
                null
        };

        transaction.metadata = {
            ...(transaction.metadata || {}),
            providerStatus:
                providerResult?.status ||
                "failed",
            providerMessage:
                providerResult?.message ||
                null
        };

        await payment.save();
        await transaction.save();

        await triggerWebhook(
            business._id,
            "payment.created",
            {
                payment:
                    payment.toObject(),
                transaction:
                    transaction.toObject()
            }
        );

        return {
            payment,
            transaction,
            providerResult
        };
    }

    payment.status =
        providerResult.status ||
        "processing";

    transaction.status =
        providerResult.status ||
        "processing";

    if (
        providerResult.providerTransactionId
    ) {
        payment.providerTransactionId =
            providerResult.providerTransactionId;

        transaction.providerTransactionId =
            providerResult.providerTransactionId;
    }

    if (
        providerResult.providerReference
    ) {
        payment.providerReference =
            providerResult.providerReference;

        transaction.providerReference =
            providerResult.providerReference;
    }

    if (
        providerResult.fee !== undefined
    ) {
        payment.fee =
            providerResult.fee;

        transaction.fee =
            providerResult.fee;
    }

    if (
        providerResult.netAmount !== undefined
    ) {
        payment.netAmount =
            providerResult.netAmount;

        transaction.netAmount =
            providerResult.netAmount;
    }

    if (
        providerResult.settlementCurrency
    ) {
        payment.settlementCurrency =
            providerResult
                .settlementCurrency;

        transaction.settlementCurrency =
            providerResult
                .settlementCurrency;
    }

    if (
        providerResult.exchangeRate !==
        undefined
    ) {
        payment.exchangeRate =
            providerResult.exchangeRate;

        transaction.exchangeRate =
            providerResult.exchangeRate;
    }

    const checkoutRequestId =
        providerResult.checkoutRequestId ||
        providerResult.providerResponse
            ?.CheckoutRequestID ||
        null;

    const merchantRequestId =
        providerResult.merchantRequestId ||
        providerResult.providerResponse
            ?.MerchantRequestID ||
        null;

    if (checkoutRequestId) {
        payment.checkoutRequestId =
            checkoutRequestId;
    }

    if (merchantRequestId) {
        payment.merchantRequestId =
            merchantRequestId;
    }

    payment.metadata = {
        ...(payment.metadata || {}),
        providerStatus:
            providerResult.status ||
            null,
        ...(checkoutRequestId
            ? {
                checkoutRequestId
            }
            : {}),
        ...(merchantRequestId
            ? {
                merchantRequestId
            }
            : {})
    };

    transaction.metadata = {
        ...(transaction.metadata || {}),
        providerStatus:
            providerResult.status ||
            null,
        ...(checkoutRequestId
            ? {
                checkoutRequestId
            }
            : {}),
        ...(merchantRequestId
            ? {
                merchantRequestId
            }
            : {})
    };

    await payment.save();
    await transaction.save();

    await triggerWebhook(
        business._id,
        "payment.created",
        {
            payment:
                payment.toObject(),
            transaction:
                transaction.toObject()
        }
    );

    return {
        payment,
        transaction,
        providerResult,
        idempotentReplay: false
    };
};

const getTransaction = async ({
    businessId,
    reference
}) => {
    if (!businessId || !reference) {
        throw new Error(
            "Business ID and transaction reference are required."
        );
    }

    const transaction =
        await Transaction.findOne({
            business: businessId,
            reference
        });

    if (!transaction) {
        throw new Error(
            "Transaction not found."
        );
    }

    return transaction;
};

module.exports = {
    createPayment,
    getTransaction
};
